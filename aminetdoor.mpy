#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""
AminetDoor M0
A small Aminet reader for Mystic BBS using Mystic Python 3.

M1 slice: Recent uploads, Browse, Search, and a paged README reader.
No third-party Python packages required.
"""

import html
import errno
from html.parser import HTMLParser
import os
import re
import socket
import ssl
import sys
import textwrap
import unicodedata
import urllib.error
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET

import mystic_bbs as bbs

VERSION = "0.1.0"
FEED_URL = "https://aminet.net/feed"
README_URL_TEMPLATE = "https://aminet.net/%s.readme"
TREE_URL = "https://aminet.net/tree"
CATEGORY_URL_TEMPLATE = "https://aminet.net/%s"
SEARCH_URL = "https://aminet.net/search"
USER_AGENT = "AminetDoor/0.1.0 (Mystic BBS door; https://github.com/pgousdal/AminetDoor-mpy)"
HTTP_TIMEOUT = 10
RECENT_LIMIT = 20
SEARCH_RESULT_LIMIT = 20
MAX_SEARCH_QUERY = 60
MAX_RESPONSE_BYTES = 250000
CA_BUNDLE_CANDIDATES = (
    "/etc/ssl/certs/ca-certificates.crt",
    "/etc/pki/tls/certs/ca-bundle.crt",
    "/etc/ssl/cert.pem",
)
RESULT_SELECTOR = "lightbar"  # "lightbar" or "numbered"
VISIBLE_RESULT_ROWS = 12
TEXT_WIDTH = 76
PAGE_LINES = 16
MAX_README_BYTES = 40000
DEBUG_KEYS = False
DEBUG_NETWORK = False


class AminetDoorError(Exception):
    """Expected AminetDoor/network error."""


class AminetMarkupError(AminetDoorError):
    """Aminet responded successfully but not in a recognized page format."""


def terminal_text(value):
    """Return conservative terminal-friendly text without control characters."""
    if value is None:
        return ""
    value = html.unescape(str(value))
    value = value.replace("\r\n", "\n").replace("\r", "\n")
    value = value.replace("\u00a0", " ")
    value = value.replace("\u2018", "'").replace("\u2019", "'")
    value = value.replace("\u201c", '"').replace("\u201d", '"')
    value = value.replace("\u2013", "-").replace("\u2014", "--")
    value = value.replace("\u2026", "...")
    value = "".join(
        ch for ch in value
        if ch in "\n\t" or unicodedata.category(ch) not in {"Cc", "Cf"}
    )
    return value


def clean_extract(value):
    """Clean plain text for BBS display."""
    value = terminal_text(value)
    value = re.sub(r"\n[ \t]+", "\n", value)
    value = re.sub(r"[ \t]+", " ", value)
    value = re.sub(r"\n{3,}", "\n\n", value)
    return value.strip()


def wrap_text(value, width=TEXT_WIDTH):
    """Wrap paragraphs to terminal width while keeping blank lines."""
    lines = []
    for paragraph in clean_extract(value).split("\n"):
        paragraph = paragraph.strip()
        if not paragraph:
            lines.append("")
            continue
        lines.extend(
            textwrap.wrap(
                paragraph,
                width=width,
                replace_whitespace=True,
                drop_whitespace=True,
                break_long_words=False,
                break_on_hyphens=False,
            ) or [""]
        )
    return lines


def http_get(url, max_bytes=MAX_RESPONSE_BYTES):
    """Perform a GET request and return the raw response bytes."""
    request = urllib.request.Request(
        url,
        headers={
            "User-Agent": USER_AGENT,
            "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
            "Accept-Encoding": "identity",
            "Connection": "close",
        },
    )
    try:
        with urllib.request.urlopen(
                request, timeout=HTTP_TIMEOUT, context=verified_ssl_context()) as response:
            raw = response.read(max_bytes + 1)
            return raw[:max_bytes]
    except urllib.error.HTTPError as exc:
        debug_network_error(url, exc)
        raise AminetDoorError("Aminet returned HTTP %s." % exc.code)
    except urllib.error.URLError as exc:
        debug_network_error(url, exc)
        raise AminetDoorError(classify_network_error(exc.reason))
    except (socket.timeout, TimeoutError) as exc:
        debug_network_error(url, exc)
        raise AminetDoorError("Aminet request timed out.")
    except ssl.SSLError as exc:
        debug_network_error(url, exc)
        raise AminetDoorError("TLS connection to Aminet failed.")
    except OSError as exc:
        debug_network_error(url, exc)
        raise AminetDoorError(classify_network_error(exc))


def debug_network_error(url, exc):
    """Display safe low-level network details only in developer mode."""
    if not DEBUG_NETWORK:
        return
    debug_network_runtime()
    reason = getattr(exc, "reason", None)
    bbs.writeln("|08HTTP URL: %s" % url)
    bbs.writeln("|08Exception type: %s" % type(exc).__name__)
    bbs.writeln("|08Exception: %r" % (exc,))
    if reason is not None:
        bbs.writeln("|08Reason type: %s" % type(reason).__name__)
        bbs.writeln("|08Reason: %r" % (reason,))


def debug_network_runtime():
    """Display runtime and transport configuration only in developer mode."""
    if not DEBUG_NETWORK:
        return
    paths = ssl.get_default_verify_paths()
    proxies = urllib.request.getproxies()
    bbs.writeln("|08Python: %s" % sys.version.replace("\n", " "))
    bbs.writeln("|08Executable: %s" % sys.executable)
    bbs.writeln("|08OpenSSL: %s" % ssl.OPENSSL_VERSION)
    bbs.writeln("|08CA cafile: %r" % paths.cafile)
    bbs.writeln("|08CA capath: %r" % paths.capath)
    bbs.writeln("|08Proxy keys: %r" % sorted(proxies))


def verified_ssl_context():
    """Return a verified context, using a standard CA bundle when needed."""
    context = ssl.create_default_context()
    paths = ssl.get_default_verify_paths()
    if ((paths.cafile and os.path.isfile(paths.cafile))
            or (paths.capath and os.path.isdir(paths.capath))):
        return context
    for cafile in CA_BUNDLE_CANDIDATES:
        if os.path.isfile(cafile):
            return ssl.create_default_context(cafile=cafile)
    return context


def classify_network_error(reason):
    """Return a concise caller-safe message for a URL error reason."""
    if isinstance(reason, socket.gaierror):
        return "Could not resolve aminet.net."
    if isinstance(reason, ssl.SSLCertVerificationError):
        return "TLS certificate verification failed."
    if isinstance(reason, ssl.SSLError):
        return "TLS connection to Aminet failed."
    if isinstance(reason, ConnectionRefusedError):
        return "Connection to Aminet was refused."
    if isinstance(reason, (socket.timeout, TimeoutError)):
        return "Aminet request timed out."
    reason_errno = getattr(reason, "errno", None)
    dns_errors = tuple(
        value for value in (
            getattr(socket, "EAI_AGAIN", None),
            getattr(socket, "EAI_FAIL", None),
            getattr(socket, "EAI_NONAME", None),
        )
        if value is not None
    )
    if reason_errno in dns_errors:
        return "Could not resolve aminet.net."
    if reason_errno == errno.ECONNREFUSED:
        return "Connection to Aminet was refused."
    if reason_errno == errno.ETIMEDOUT:
        return "Aminet request timed out."
    return "Aminet network request failed."


def package_path_from_link(link):
    """Return the package path (dir/name, without extension) from a feed link.

    Aminet RSS item links point at package pages, e.g.
    https://aminet.net/package/comm/net/amiagent-0.5.3
    The .readme file for that package sits alongside the download, e.g.
    https://aminet.net/comm/net/amiagent-0.5.3.readme
    """
    parsed = urllib.parse.urlparse(link)
    parts = parsed.path.strip("/").split("/")
    if parts and parts[0] == "package":
        parts = parts[1:]
    return "/".join(parts)


def parse_recent_feed(raw_xml):
    """Parse an Aminet RSS feed into a list of recent-upload dicts."""
    try:
        root = ET.fromstring(raw_xml)
    except ET.ParseError:
        raise AminetDoorError("Aminet returned an unreadable feed.")

    items = []
    for item in root.iter("item"):
        title_el = item.find("title")
        link_el = item.find("link")
        desc_el = item.find("description")
        title = terminal_text(title_el.text) if title_el is not None else ""
        link = (link_el.text or "").strip() if link_el is not None else ""
        description = terminal_text(desc_el.text) if desc_el is not None else ""
        if not title or not link:
            continue
        path = package_path_from_link(link)
        if not path:
            continue
        items.append({"title": title, "link": link, "description": description, "path": path})
        if len(items) >= RECENT_LIMIT:
            break
    return items


def fetch_recent():
    """Fetch and parse the Aminet recent-uploads RSS feed."""
    raw = http_get(FEED_URL)
    return parse_recent_feed(raw)


class AminetHTMLParser(HTMLParser):
    """Extract Aminet category links and package table rows."""

    def __init__(self):
        HTMLParser.__init__(self, convert_charrefs=True)
        self.categories = []
        self.rows = []
        self._anchor = None
        self._cell = None
        self._row = None
        self._li = None

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == "a":
            self._anchor = [attrs.get("href", ""), []]
        elif tag == "tr":
            self._row = []
        elif tag == "td" and self._row is not None:
            self._cell = [[], []]
        elif tag == "li":
            self._li = [[], None]

    def handle_data(self, data):
        if self._anchor is not None:
            self._anchor[1].append(data)
        if self._cell is not None:
            self._cell[0].append(data)
        if self._li is not None:
            self._li[0].append(data)

    def handle_endtag(self, tag):
        if tag == "a" and self._anchor is not None:
            href, text = self._anchor
            if self._cell is not None:
                self._cell[1].append((href, clean_extract(" ".join(text))))
            if self._li is not None and href:
                self._li[1] = (href, clean_extract(" ".join(text)))
            self._anchor = None
        elif tag == "td" and self._cell is not None:
            self._row.append((clean_extract(" ".join(self._cell[0])), self._cell[1]))
            self._cell = None
        elif tag == "tr" and self._row is not None:
            if self._row:
                self.rows.append(self._row)
            self._row = None
        elif tag == "li" and self._li is not None:
            if self._li[1] is not None:
                href, title = self._li[1]
                self.categories.append((href, title, clean_extract(" ".join(self._li[0]))))
            self._li = None


def html_text(raw_html):
    """Decode Aminet's legacy HTML response for the stdlib parser."""
    try:
        return raw_html.decode("utf-8")
    except UnicodeDecodeError:
        return raw_html.decode("latin-1", "replace")


def _category_path(href):
    resolved = urllib.parse.urljoin("https://aminet.net/", href)
    parsed = urllib.parse.urlparse(resolved)
    if parsed.netloc.lower() not in ("aminet.net", "www.aminet.net"):
        return ""
    if parsed.path.rstrip("/") == "/tree":
        path = urllib.parse.parse_qs(parsed.query).get("path", [""])[0].strip("/")
    else:
        path = parsed.path.strip("/")
        if len(path.split("/")) < 2:
            return ""
    if not re.match(r"^[A-Za-z0-9_+-]+(?:/[A-Za-z0-9_+-]+)*$", path):
        return ""
    return path


def _package_from_row(row):
    if len(row) < 5:
        return None
    links = [link for _, cell_links in row for link in cell_links]
    detail_link = next((href for href, _ in links if href.startswith("/package/")), "")
    if not detail_link:
        return None
    file_link, file_title = next(
        ((href, text) for href, text in links
         if href.startswith("/") and not href.startswith(("/package/", "/tree", "/search"))
         and not href.endswith(".readme")),
        ("", ""),
    )
    path = package_path_from_link(detail_link)
    if not path:
        return None
    description = row[-1][0]
    description = re.sub(r"\s+-\s+\(readme\)\s*$", "", description)
    return {
        "title": file_title or path.rsplit("/", 1)[-1],
        "path": path,
        "description": clean_extract(description),
        "version": row[1][0] if len(row) > 1 else "",
        "size": row[4][0] if len(row) > 4 else "",
        "link": urllib.parse.urljoin(TREE_URL, file_link or detail_link),
    }


def parse_aminet_html(raw_html):
    """Parse category links and package rows from an Aminet HTML page."""
    parser = AminetHTMLParser()
    try:
        parser.feed(html_text(raw_html))
        parser.close()
    except (ValueError, TypeError):
        raise AminetDoorError("Aminet returned unreadable browse/search data.")

    categories = []
    seen_categories = set()
    for href, title, full_text in parser.categories:
        path = _category_path(href)
        if not path or path in seen_categories:
            continue
        description = full_text
        if " - " in description:
            description = description.split(" - ", 1)[1]
        description = re.sub(r"\s*\(\d+ packages\)\s*$", "", description)
        categories.append({"kind": "category", "title": path, "path": path,
                           "description": clean_extract(description), "link": href})
        seen_categories.add(path)

    packages = []
    seen_packages = set()
    for row in parser.rows:
        package = _package_from_row(row)
        if package and package["path"] not in seen_packages:
            packages.append(package)
            seen_packages.add(package["path"])
    if not categories and not packages:
        page_text = html_text(raw_html).lower()
        recognized = (
            "aminet - " in page_text
            or "found 0 matching packages" in page_text
            or 'id="start_listing"' in page_text
        )
        if not recognized:
            raise AminetMarkupError(
                "Aminet returned a page format this version could not read."
            )
    return categories, packages


def child_categories(categories, parent_path):
    """Keep only immediate children of a browse path."""
    parent_parts = [part for part in parent_path.strip("/").split("/") if part]
    result = []
    for category in categories:
        parts = category["path"].split("/")
        if parts[:len(parent_parts)] == parent_parts and len(parts) == len(parent_parts) + 1:
            result.append(category)
    return result


def fetch_browse(path=""):
    """Fetch one level of Aminet's tree, or packages at a leaf path."""
    if path and not re.match(r"^[A-Za-z0-9_+-]+(?:/[A-Za-z0-9_+-]+)*$", path):
        raise AminetDoorError("Aminet returned an unsafe browse path.")
    query = urllib.parse.urlencode({"path": path}) if path else ""
    raw = http_get(TREE_URL + ("?" + query if query else ""))
    categories, packages = parse_aminet_html(raw)
    categories = child_categories(categories, path)
    if path and not categories:
        raw = http_get(CATEGORY_URL_TEMPLATE % urllib.parse.quote(path, safe="/"))
        _, packages = parse_aminet_html(raw)
    if DEBUG_NETWORK:
        bbs.writeln("|08Browse URL: %s" % (TREE_URL + ("?" + query if query else "")))
        bbs.writeln("|08Parsed categories: %d" % len(categories))
        bbs.writeln("|08Parsed packages: %d" % len(packages))
    return categories, packages


def build_search_url(query, page=1):
    """Build Aminet's public GET search URL with bounded user input."""
    query = terminal_text(query).strip()[:MAX_SEARCH_QUERY]
    values = {"query": query}
    if page > 1:
        values["page"] = page
    return SEARCH_URL + "?" + urllib.parse.urlencode(values)


def fetch_search(query):
    """Fetch the first page of Aminet's public search results."""
    url = build_search_url(query)
    raw = http_get(url)
    _, packages = parse_aminet_html(raw)
    packages = packages[:SEARCH_RESULT_LIMIT]
    if DEBUG_NETWORK:
        bbs.writeln("|08Search URL: %s" % url)
        bbs.writeln("|08Search result count: %d" % len(packages))
    return packages


def fetch_readme(path):
    """Fetch the plain-text .readme file for a package path."""
    url = README_URL_TEMPLATE % path
    raw = http_get(url)
    if len(raw) > MAX_README_BYTES:
        raw = raw[:MAX_README_BYTES]
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        text = raw.decode("latin-1", "replace")
    text = clean_extract(text)
    if not text:
        raise AminetDoorError("No readable text was returned.")
    return text


def line(char="-"):
    return char * 78


def clear_screen():
    bbs.write("|CL")


def heading(title):
    clear_screen()
    bbs.writeln("|15" + line("="))
    bbs.writeln("|11 AminetDoor |07v%s  |08-  Aminet from your BBS" % VERSION)
    bbs.writeln("|15" + line("="))
    if title:
        safe = terminal_text(title)
        if len(safe) > 72:
            safe = safe[:69] + "..."
        bbs.writeln("|14 " + safe)
        bbs.writeln("|08" + line("-"))


def pause(message="Press any key"):
    bbs.write("|08%s..." % message)
    bbs.onekey(chr(13) + "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 ", False)


def mystic_getstr(max_length, field_width=80, default=""):
    """Read a string using Mystic's four-argument Python binding."""
    return bbs.getstr(1, max_length, field_width, default)


def search_query_input():
    """Read and bound one Search query from Mystic."""
    value = terminal_text(mystic_getstr(MAX_SEARCH_QUERY)).strip()
    return value[:MAX_SEARCH_QUERY]


def diagnose_key(value):
    """Optionally show the raw value returned by Mystic while debugging keys."""
    if not DEBUG_KEYS:
        return
    values = value if isinstance(value, tuple) else (value,)
    bbs.writeln("|08key=%r type=%s length=%s ordinals=%r" % (
        value,
        type(value).__name__,
        len(value) if hasattr(value, "__len__") else "n/a",
        [ord(ch) for ch in values[0] if isinstance(values[0], str)]
        if values and isinstance(values[0], str) else [],
    ))


def normalize_selector_key(key):
    """Translate Mystic getkey() values into selector actions."""
    diagnose_key(key)
    value = key[0] if isinstance(key, tuple) and key else key
    extended = (
        isinstance(key, tuple) and len(key) > 1 and key[1] is True
    )
    if extended and value == "H":
        return "up"
    if extended and value == "P":
        return "down"
    if value in ("\r", "\n", 13):
        return "enter"
    if isinstance(value, str) and value.upper() == "Q":
        return "quit"
    if isinstance(value, str) and value.upper() == "B":
        return "back"
    if isinstance(value, str) and value.upper() == "R":
        return "root"
    if isinstance(value, str) and value.upper() == "S":
        return "search"
    return "unknown"


def selector_mode():
    """Return a safe selector mode, falling back for a SysOp typo."""
    if RESULT_SELECTOR in ("lightbar", "numbered"):
        return RESULT_SELECTOR
    return "numbered"


def move_selector(selected_index, viewport_start, action, item_count,
                  visible_rows=VISIBLE_RESULT_ROWS):
    """Apply a selector action and return (selection, viewport) state."""
    if not item_count:
        return 0, 0, action
    last_index = item_count - 1
    if action == "up":
        selected_index = max(0, selected_index - 1)
    elif action == "down":
        selected_index = min(last_index, selected_index + 1)
    elif action in ("enter", "quit"):
        return selected_index, viewport_start, action

    if selected_index < viewport_start:
        viewport_start = selected_index
    elif selected_index >= viewport_start + visible_rows:
        viewport_start = selected_index - visible_rows + 1
    max_start = max(0, item_count - visible_rows)
    viewport_start = min(viewport_start, max_start)
    return selected_index, viewport_start, "unknown"


def show_error(message):
    bbs.writeln("")
    bbs.writeln("|12Error: |07" + terminal_text(message))
    bbs.writeln("")
    pause()


def read_readme(package_title, path):
    try:
        text = fetch_readme(path)
    except AminetDoorError as exc:
        show_error(str(exc))
        return

    lines = wrap_text(text)
    if not lines:
        show_error("No readable README text was returned.")
        return

    page_count = max(1, (len(lines) + PAGE_LINES - 1) // PAGE_LINES)
    page = 0

    while True:
        heading(package_title)
        start = page * PAGE_LINES
        end = min(start + PAGE_LINES, len(lines))
        for text_line in lines[start:end]:
            bbs.writeln("|07" + text_line)
        for _ in range(PAGE_LINES - (end - start)):
            bbs.writeln("")

        bbs.writeln("|08" + line("-"))
        bbs.writeln(
            "|11Page %d/%d  |15[N]|07ext  |15[P]|07rev  |15[Q]|07uit readme"
            % (page + 1, page_count)
        )
        key = bbs.onekey("NPQ", False).upper()
        if key == "N" and page < page_count - 1:
            page += 1
        elif key == "P" and page > 0:
            page -= 1
        elif key == "Q":
            return


def package_display(item):
    """Format compact package metadata for an 80-column result row."""
    title = terminal_text(item.get("title", ""))
    version = terminal_text(item.get("version", ""))
    size = terminal_text(item.get("size", ""))
    description = terminal_text(item.get("description", ""))
    suffix = "  ".join(part for part in (version, size) if part)
    if suffix:
        suffix = "  " + suffix
    text = title + suffix
    if description:
        text += "  " + description
    return text


def category_display(item):
    title = terminal_text(item.get("title", ""))
    description = terminal_text(item.get("description", ""))
    return title + ("  " + description if description else "")


def render_lightbar(items, selected_index, viewport_start, title="Recent uploads",
                    formatter=None, controls="Up/Down Move   Enter Read   Q Back"):
    heading(title)
    formatter = formatter or (lambda item: item.get("title", ""))
    visible_end = min(viewport_start + VISIBLE_RESULT_ROWS, len(items))
    for index in range(viewport_start, visible_end):
        marker = ">  " if index == selected_index else "   "
        row_text = terminal_text(formatter(items[index]))
        width = 76 - len(marker)
        if len(row_text) > width:
            row_text = row_text[:max(0, width - 3)] + "..."
        bbs.writeln("|15%s|07%s" % (marker, row_text))
    for _ in range(VISIBLE_RESULT_ROWS - (visible_end - viewport_start)):
        bbs.writeln("")
    bbs.writeln("|08" + line("-"))
    bbs.writeln("|11%s" % controls)


def choose_result_lightbar(items, title="Recent uploads", formatter=None,
                           controls="Up/Down Move   Enter Read   Q Back",
                           extra_actions=()):
    """Select an item using Mystic's native extended-key input."""
    selected_index = 0
    viewport_start = 0
    while True:
        render_lightbar(items, selected_index, viewport_start, title, formatter, controls)
        action = normalize_selector_key(bbs.getkey())
        selected_index, viewport_start, action = move_selector(
            selected_index, viewport_start, action, len(items)
        )
        if action == "enter":
            return items[selected_index]
        if action == "quit":
            return None
        if action in extra_actions:
            return action


def render_numbered(items, page):
    heading("Recent uploads")
    page_count = max(1, (len(items) + VISIBLE_RESULT_ROWS - 1) // VISIBLE_RESULT_ROWS)
    start = page * VISIBLE_RESULT_ROWS
    end = min(start + VISIBLE_RESULT_ROWS, len(items))
    for index in range(start, end):
        title = terminal_text(items[index].get("title", ""))
        if len(title) > 69:
            title = title[:66] + "..."
        bbs.writeln("|15 %2d.|07 %s" % (index + 1, title))
    for _ in range(VISIBLE_RESULT_ROWS - (end - start)):
        bbs.writeln("")
    bbs.writeln("|08" + line("-"))
    bbs.write("|11Choose package |08[1-%d] |11Page %d/%d, or |15Q|11: " % (
        len(items), page + 1, page_count
    ))


def choose_result_numbered(items):
    """Select an item with multi-digit Mystic string input."""
    page = 0
    page_count = max(1, (len(items) + VISIBLE_RESULT_ROWS - 1) // VISIBLE_RESULT_ROWS)
    while True:
        render_numbered(items, page)
        value = mystic_getstr(2)
        value = terminal_text(value).strip()
        if value.upper() == "Q":
            return None
        if value.upper() == "N" and page < page_count - 1:
            page += 1
            continue
        if value.upper() == "P" and page > 0:
            page -= 1
            continue
        try:
            index = int(value) - 1
            if index < 0:
                raise IndexError
            selected = items[index]
        except (ValueError, IndexError, TypeError):
            continue
        return selected


def choose_recent_result(items):
    """Dispatch parsed recent items to the configured result selector."""
    if selector_mode() == "lightbar":
        return choose_result_lightbar(items)
    return choose_result_numbered(items)


def show_recent():
    try:
        items = fetch_recent()
    except AminetDoorError as exc:
        show_error(str(exc))
        return
    if not items:
        show_error("No recent uploads were returned.")
        return
    selected = choose_recent_result(items)
    if selected is not None:
        read_readme(selected["title"], selected["path"])


def choose_browse_entry(items, path):
    """Select a browse category/package while honoring browse controls."""
    title = "Browse" if not path else "Browse: " + path
    formatter = category_display if items and items[0].get("kind") == "category" else package_display
    return choose_result_lightbar(
        items,
        title=title,
        formatter=formatter,
        controls="Up/Down Move   Enter Open   B Back   R Root   Q Quit",
        extra_actions=("back", "root"),
    )


def browse_path_after_action(path, action, selected=None):
    """Return the next browse path, or None when Browse should exit."""
    if action == "root":
        return ""
    if action == "back":
        if "/" in path:
            return path.rsplit("/", 1)[0]
        return "" if path else None
    if isinstance(selected, dict) and selected.get("kind") == "category":
        return selected.get("path", path)
    return path


def browse():
    """Browse Aminet's category tree and package listings."""
    path = ""
    while True:
        try:
            categories, packages = fetch_browse(path)
        except AminetDoorError as exc:
            show_error(str(exc))
            return
        entries = categories or packages
        if not entries:
            show_error("No browse entries were returned.")
            return
        selected = choose_browse_entry(entries, path)
        if selected in ("back", "root"):
            path = browse_path_after_action(path, selected)
            if path is None:
                return
        elif selected is None:
            return
        elif selected.get("kind") == "category":
            path = browse_path_after_action(path, "enter", selected)
        else:
            read_readme(selected["title"], selected["path"])


def search():
    """Prompt for bounded queries and display Aminet search results."""
    while True:
        heading("Search Aminet")
        bbs.writeln("|07Enter a package name or keyword (max %d characters)." % MAX_SEARCH_QUERY)
        bbs.writeln("|08Q returns to the main menu.")
        bbs.write("|11Search: |15")
        query = search_query_input()
        if not query:
            continue
        if query.upper() == "Q":
            return
        try:
            items = fetch_search(query)
        except AminetDoorError as exc:
            show_error(str(exc))
            return
        if not items:
            show_error("No packages matched that search.")
            continue
        selected = choose_result_lightbar(
            items,
            title="Search: " + query,
            formatter=package_display,
            controls="Up/Down Move   Enter Read   S New search   Q Back",
            extra_actions=("search",),
        )
        if selected == "search":
            continue
        if selected is not None:
            read_readme(selected["title"], selected["path"])


def about():
    heading("About")
    bbs.writeln("|07AminetDoor is an open-source Aminet browser for Mystic BBS.")
    bbs.writeln("")
    bbs.writeln("|07(c) 2026 Per Gustav Ousdal")
    bbs.writeln("|07Phrenetic BBS")
    bbs.writeln("|07telnet: bbs.phrenetic.no")
    bbs.writeln("")
    bbs.writeln("|07Released under the MIT License.")
    bbs.writeln("")
    bbs.writeln("|08" + line("-"))
    bbs.writeln("|07Powered by Aminet.")
    bbs.writeln("")
    bbs.writeln("|07Package descriptions and README text remain subject to the")
    bbs.writeln("|07licensing/copyright terms of their original authors.")
    bbs.writeln("")
    pause()


def main():
    while True:
        heading("Main menu")
        bbs.writeln("")
        bbs.writeln("|15 [R]|07 Recent uploads")
        bbs.writeln("|15 [B]|07 Browse Aminet")
        bbs.writeln("|15 [S]|07 Search Aminet")
        bbs.writeln("|15 [A]|07 About")
        bbs.writeln("|15 [Q]|07 Return to BBS")
        bbs.writeln("")
        bbs.write("|11Select: |15")
        key = bbs.onekey("RBSAQ", True).upper()

        if key == "Q":
            clear_screen()
            return
        if key == "A":
            about()
        elif key == "R":
            show_recent()
        elif key == "B":
            browse()
        elif key == "S":
            search()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        clear_screen()
    except Exception as exc:
        try:
            bbs.writeln("")
            bbs.writeln("|12AminetDoor stopped: |07" + terminal_text(str(exc)))
            bbs.writeln("|08Please report this to the SysOp.")
            bbs.writeln("")
            pause()
        except Exception:
            pass
