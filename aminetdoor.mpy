class AminetDoorError(Exception):
    """Expected AminetDoor/network error."""


class AminetTransientError(AminetDoorError):
    """A temporary upstream HTTP failure suitable for stale-cache fallback."""


class AminetTransportError(AminetDoorError):
    """A transport failure suitable for stale-cache fallback."""


class AminetMarkupError(AminetDoorError):
    """Aminet responded successfully but not in a recognized page format."""


def terminal_text(value):
    """Return conservative terminal-friendly text without control characters."""
    if value is None:
        return ""
    value = html.unescape(str(value))
    value = value.replace("\r\n", "\n").replace("\r", "\n")
    value = value.replace("\u00a0", " ")
    value = value.replace("\u2018", "'").replace("\u2019", "'")
    value = value.replace("\u201c", '"').replace("\u201d", '"')
    value = value.replace("\u2013", "-").replace("\u2014", "--")
    value = value.replace("\u2026", "...")
    value = "".join(
        ch for ch in value
        if ch in "\n\t" or unicodedata.category(ch) not in {"Cc", "Cf"}
    )
    return value


def clean_extract(value):
    """Clean plain text for BBS display."""
    value = terminal_text(value)
    value = re.sub(r"\n[ \t]+", "\n", value)
    value = re.sub(r"[ \t]+", " ", value)
    value = re.sub(r"\n{3,}", "\n\n", value)
    return value.strip()


def wrap_text(value, width=TEXT_WIDTH):
    """Wrap paragraphs to terminal width while keeping blank lines."""
    lines = []
    for paragraph in clean_extract(value).split("\n"):
        paragraph = paragraph.strip()
        if not paragraph:
            lines.append("")
            continue
        lines.extend(
            textwrap.wrap(
                paragraph,
                width=width,
                replace_whitespace=True,
                drop_whitespace=True,
                break_long_words=False,
                break_on_hyphens=False,
            ) or [""]
        )
    return lines


def http_get(url, max_bytes=MAX_RESPONSE_BYTES, diagnostics=None):
    """Perform a GET request and return the raw response bytes."""
    request = urllib.request.Request(
        url,
        headers={
            "User-Agent": USER_AGENT,
            "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
            "Accept-Encoding": "identity",
            "Connection": "close",
        },
    )
    attempts = HTTP_RETRIES + 1
    if diagnostics is not None:
        diagnostics["url"] = url
    for attempt in range(1, attempts + 1):
        try:
            with urllib.request.urlopen(
                    request, timeout=HTTP_TIMEOUT,
                    context=verified_ssl_context()) as response:
                raw = response.read(max_bytes + 1)
                body = raw[:max_bytes]
                if diagnostics is not None:
                    diagnostics.update({
                        "status": getattr(response, "status", 200),
                        "bytes": len(body),
                        "content_type": response.headers.get("Content-Type", "unknown"),
                    })
                debug_http_attempt(
                    url, attempt, attempts,
                    getattr(response, "status", 200), None,
                )
                return body
        except urllib.error.HTTPError as exc:
            if diagnostics is not None:
                diagnostics.update({
                    "status": exc.code,
                    "bytes": 0,
                    "content_type": exc.headers.get("Content-Type", "unknown")
                    if exc.headers else "unknown",
                })
            debug_http_attempt(url, attempt, attempts, exc.code, exc)
            if exc.code in TRANSIENT_HTTP_STATUSES and attempt < attempts:
                time.sleep(HTTP_RETRY_DELAY)
                continue
            debug_http_final_failure(url, exc)
            if exc.code in TRANSIENT_HTTP_STATUSES:
                raise AminetTransientError(
                    "Aminet is temporarily unavailable (HTTP %s)." % exc.code
                )
            raise AminetDoorError("Aminet returned HTTP %s." % exc.code)
        except urllib.error.URLError as exc:
            debug_network_error(url, exc)
            raise AminetTransportError(classify_network_error(exc.reason))
        except (socket.timeout, TimeoutError) as exc:
            debug_network_error(url, exc)
            raise AminetTransportError("Aminet request timed out.")
        except ssl.SSLError as exc:
            debug_network_error(url, exc)
            raise AminetTransportError("TLS connection to Aminet failed.")
        except OSError as exc:
            debug_network_error(url, exc)
            raise AminetTransportError(classify_network_error(exc))


def debug_http_attempt(url, attempt, total_attempts, status, exc):
    """Log one HTTP attempt only in developer diagnostics mode."""
    if not DEBUG_NETWORK:
        return
    exception_name = type(exc).__name__ if exc is not None else "none"
    bbs.writeln("|08GET %s" % url)
    bbs.writeln("|08attempt %d/%d -> HTTP %s (exception %s)" % (
        attempt, total_attempts, status, exception_name,
    ))


def debug_http_final_failure(url, exc):
    """Log a final HTTP failure only in developer diagnostics mode."""
    if DEBUG_NETWORK:
        bbs.writeln("|08final failure: %s HTTP %s" % (type(exc).__name__, exc.code))


def debug_network_error(url, exc):
    """Display safe low-level network details only in developer mode."""
    if not DEBUG_NETWORK:
        return
    debug_network_runtime()
    reason = getattr(exc, "reason", None)
    bbs.writeln("|08HTTP URL: %s" % url)
    bbs.writeln("|08Exception type: %s" % type(exc).__name__)
    bbs.writeln("|08Exception: %r" % (exc,))
    if reason is not None:
        bbs.writeln("|08Reason type: %s" % type(reason).__name__)
        bbs.writeln("|08Reason: %r" % (reason,))


def debug_network_runtime():
    """Display runtime and transport configuration only in developer mode."""
    if not DEBUG_NETWORK:
        return
    paths = ssl.get_default_verify_paths()
    proxies = urllib.request.getproxies()
    bbs.writeln("|08Python: %s" % sys.version.replace("\n", " "))
    bbs.writeln("|08Executable: %s" % sys.executable)
    bbs.writeln("|08OpenSSL: %s" % ssl.OPENSSL_VERSION)
    bbs.writeln("|08CA cafile: %r" % paths.cafile)
    bbs.writeln("|08CA capath: %r" % paths.capath)
    bbs.writeln("|08Proxy keys: %r" % sorted(proxies))


def verified_ssl_context():
    """Return a verified context, using a standard CA bundle when needed."""
    context = ssl.create_default_context()
    paths = ssl.get_default_verify_paths()
    if ((paths.cafile and os.path.isfile(paths.cafile))
            or (paths.capath and os.path.isdir(paths.capath))):
        return context
    for cafile in CA_BUNDLE_CANDIDATES:
        if os.path.isfile(cafile):
            return ssl.create_default_context(cafile=cafile)
    return context


def classify_network_error(reason):
    """Return a concise caller-safe message for a URL error reason."""
    if isinstance(reason, socket.gaierror):
        return "Could not resolve aminet.net."
    if isinstance(reason, ssl.SSLCertVerificationError):
        return "TLS certificate verification failed."
    if isinstance(reason, ssl.SSLError):
        return "TLS connection to Aminet failed."
    if isinstance(reason, ConnectionRefusedError):
        return "Connection to Aminet was refused."
    if isinstance(reason, (socket.timeout, TimeoutError)):
        return "Aminet request timed out."
    reason_errno = getattr(reason, "errno", None)
    dns_errors = tuple(
        value for value in (
            getattr(socket, "EAI_AGAIN", None),
            getattr(socket, "EAI_FAIL", None),
            getattr(socket, "EAI_NONAME", None),
        )
        if value is not None
    )
    if reason_errno in dns_errors:
        return "Could not resolve aminet.net."
    if reason_errno == errno.ECONNREFUSED:
        return "Connection to Aminet was refused."
    if reason_errno == errno.ETIMEDOUT:
        return "Aminet request timed out."
    return "Aminet network request failed."


def package_path_from_link(link):
    """Return the package path (dir/name, without extension) from a feed link.

    Aminet RSS item links point at package pages, e.g.
    https://aminet.net/package/comm/net/amiagent-0.5.3
    The .readme file for that package sits alongside the download, e.g.
    https://aminet.net/comm/net/amiagent-0.5.3.readme
    """
    parsed = urllib.parse.urlparse(link)
    parts = parsed.path.strip("/").split("/")
    if parts and parts[0] == "package":
        parts = parts[1:]
    return "/".join(parts)


def normalize_architecture_filter(value):
    """Return valid configured architectures, or None for an unfiltered view."""
    if value is None or isinstance(value, str):
        return None
    try:
        values = list(value)
    except TypeError:
        return None
    result = []
    for architecture in values:
        if (isinstance(architecture, str)
                and architecture in KNOWN_ARCHITECTURES
                and architecture not in result):
            result.append(architecture)
    return tuple(result) or None


def build_advanced_search_url(query="", path="", architectures=(), page=1):
    """Build Aminet's public Advanced Search URL with architecture filters."""
    values = [("type", "advanced")]
    query = terminal_text(query).strip()[:MAX_SEARCH_QUERY]
    if query:
        # This mirrors the public simple-search expansion to name OR description.
        values.extend((("name", query), ("q_desc", "OR"), ("desc", query)))
    if path:
        values.append(("path[]", path.strip("/")))
    if architectures:
        values.append(("q_arch", "AND"))
        values.extend(("arch[]", architecture) for architecture in architectures)
    if page > 1:
        values.append(("page", page))
    return SEARCH_URL + "?" + urllib.parse.urlencode(values)


def architecture_from_link(link):
    """Return Aminet's architecture identifier from a package-row link."""
    parsed = urllib.parse.urlparse(urllib.parse.urljoin("https://aminet.net/", link))
    host = (parsed.hostname or "").lower()
    return next((architecture for architecture, short_host in ARCHITECTURE_HOSTS.items()
                 if host == short_host + ".aminet.net"), "")


def merge_packages(package_lists, limit=None):
    """Merge package records by canonical path, preserving first-seen order."""
    merged = {}
    order = []
    for packages in package_lists:
        for package in packages:
            path = package.get("path", "") if isinstance(package, dict) else ""
            if not path:
                continue
            if path not in merged:
                merged[path] = dict(package)
                order.append(path)
            else:
                for key, value in package.items():
                    if not merged[path].get(key) and value:
                        merged[path][key] = value
    result = [merged[path] for path in order]
    return result if limit is None else result[:limit]


def parse_recent_feed(raw_xml):
    """Parse an Aminet RSS feed into a list of recent-upload dicts."""
    try:
        root = ET.fromstring(raw_xml)
    except ET.ParseError:
        raise AminetDoorError("Aminet returned an unreadable recent-upload feed.")

    items = []
    for item in root.iter("item"):
        title_el = item.find("title")
        link_el = item.find("link")
        desc_el = item.find("description")
        title = terminal_text(title_el.text) if title_el is not None else ""
        link = (link_el.text or "").strip() if link_el is not None else ""
        description = terminal_text(desc_el.text) if desc_el is not None else ""
        if not title or not link:
            continue
        path = package_path_from_link(link)
        if not path:
            continue
        items.append({"title": title, "link": link, "description": description, "path": path})
        if len(items) >= RECENT_LIMIT:
            break
    return items


def fetch_recent():
    """Fetch and parse the Aminet recent-uploads RSS feed."""
    diagnostics = {}
    try:
        raw = http_get(FEED_URL, diagnostics=diagnostics)
    except AminetDoorError as exc:
        debug_recent_diagnostics(diagnostics, 0, exc)
        raise
    try:
        items = parse_recent_feed(raw)
    except AminetDoorError as exc:
        debug_recent_diagnostics(diagnostics, 0, exc)
        raise
    debug_recent_diagnostics(diagnostics, len(items), None)
    return items


def package_of_day(items, date_value=None):
    """Choose one stable daily package from a Recent candidate pool."""
    if date_value is None:
        date_value = date.today().isoformat()
    elif hasattr(date_value, "isoformat"):
        date_value = date_value.isoformat()
    else:
        date_value = str(date_value)

    candidates = {}
    for item in items:
        if not isinstance(item, dict):
            continue
        path = item.get("path")
        if isinstance(path, str) and path.strip():
            candidates.setdefault(path.strip(), item)
    ordered = [candidates[path] for path in sorted(candidates)]
    if not ordered:
        return None
    scores = [
        hashlib.sha256((date_value + "\n" + item["path"]).encode("utf-8")).digest()
        for item in ordered
    ]
    index = 0
    best_score = scores[0]
    for candidate_index, score in enumerate(scores[1:], 1):
        if score < best_score:
            best_score = score
            index = candidate_index
    return ordered[index]


def debug_recent_diagnostics(diagnostics, item_count, error):
    """Log Recent transport and parser results only in developer mode."""
    if not DEBUG_NETWORK:
        return
    bbs.writeln("|08Recent URL: %s" % diagnostics.get("url", FEED_URL))
    bbs.writeln("|08HTTP status: %s" % diagnostics.get("status", "unknown"))
    bbs.writeln("|08bytes received: %s" % diagnostics.get("bytes", 0))
    bbs.writeln("|08content type: %s" % diagnostics.get("content_type", "unknown"))
    bbs.writeln("|08parsed item count: %d" % item_count)
    if error is not None:
        bbs.writeln("|08final failure: %s" % error)


class AminetHTMLParser(HTMLParser):
    """Extract Aminet category links and package table rows."""

    def __init__(self):
        HTMLParser.__init__(self, convert_charrefs=True)
        self.categories = []
        self.rows = []
        self._anchor = None
        self._cell = None
        self._row = None
        self._li = None

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == "a":
            self._anchor = [attrs.get("href", ""), []]
        elif tag == "tr":
            self._row = []
        elif tag == "td" and self._row is not None:
            self._cell = [[], []]
        elif tag == "li":
            self._li = [[], None]

    def handle_data(self, data):
        if self._anchor is not None:
            self._anchor[1].append(data)
        if self._cell is not None:
            self._cell[0].append(data)
        if self._li is not None:
            self._li[0].append(data)

    def handle_endtag(self, tag):
        if tag == "a" and self._anchor is not None:
            href, text = self._anchor
            if self._cell is not None:
                self._cell[1].append((href, clean_extract(" ".join(text))))
            if self._li is not None and href:
                self._li[1] = (href, clean_extract(" ".join(text)))
            self._anchor = None
        elif tag == "td" and self._cell is not None:
            self._row.append((clean_extract(" ".join(self._cell[0])), self._cell[1]))
            self._cell = None
        elif tag == "tr" and self._row is not None:
            if self._row:
                self.rows.append(self._row)
            self._row = None
        elif tag == "li" and self._li is not None:
            if self._li[1] is not None:
                href, title = self._li[1]
                self.categories.append((href, title, clean_extract(" ".join(self._li[0]))))
            self._li = None


def html_text(raw_html):
    """Decode Aminet's legacy HTML response for the stdlib parser."""
    try:
        return raw_html.decode("utf-8")
    except UnicodeDecodeError:
        return raw_html.decode("latin-1", "replace")


def _category_path(href):
    resolved = urllib.parse.urljoin("https://aminet.net/", href)
    parsed = urllib.parse.urlparse(resolved)
    if parsed.netloc.lower() not in ("aminet.net", "www.aminet.net"):
        return ""
    if parsed.path.rstrip("/") == "/tree":
        path = urllib.parse.parse_qs(parsed.query).get("path", [""])[0].strip("/")
    else:
        path = parsed.path.strip("/")
        if len(path.split("/")) < 2:
            return ""
    if not re.match(r"^[A-Za-z0-9_+-]+(?:/[A-Za-z0-9_+-]+)*$", path):
        return ""
    return path


def _package_from_row(row):
    if len(row) < 5:
        return None
    links = [link for _, cell_links in row for link in cell_links]
    detail_link = next((href for href, _ in links if href.startswith("/package/")), "")
    if not detail_link:
        return None
    file_link, file_title = next(
        ((href, text) for href, text in links
         if href.startswith("/") and not href.startswith(("/package/", "/tree", "/search"))
         and not href.endswith(".readme")),
        ("", ""),
    )
    path = package_path_from_link(detail_link)
    if not path:
        return None
    description = row[-1][0]
    description = re.sub(r"\s+-\s+\(readme\)\s*$", "", description)
    architecture = next(
        (architecture_from_link(href) for href, _ in links
         if architecture_from_link(href)),
        "",
    )
    package = {
        "title": file_title or path.rsplit("/", 1)[-1],
        "path": path,
        "description": clean_extract(description),
        "version": row[1][0] if len(row) > 1 else "",
        "size": row[4][0] if len(row) > 4 else "",
        "link": urllib.parse.urljoin(TREE_URL, file_link or detail_link),
    }
    if architecture:
        package["architecture"] = architecture
    return package


def parse_aminet_html(raw_html):
    """Parse category links and package rows from an Aminet HTML page."""
    parser = AminetHTMLParser()
    try:
        parser.feed(html_text(raw_html))
        parser.close()
    except (ValueError, TypeError):
        raise AminetDoorError("Aminet returned unreadable browse/search data.")

    categories = []
    seen_categories = set()
    for href, title, full_text in parser.categories:
        path = _category_path(href)
        if not path or path in seen_categories:
            continue
        description = full_text
        if " - " in description:
            description = description.split(" - ", 1)[1]
        description = re.sub(r"\s*\(\d+ packages\)\s*$", "", description)
        categories.append({"kind": "category", "title": path, "path": path,
                           "description": clean_extract(description), "link": href})
        seen_categories.add(path)

    packages = []
    seen_packages = set()
    for row in parser.rows:
        package = _package_from_row(row)
        if package and package["path"] not in seen_packages:
            packages.append(package)
            seen_packages.add(package["path"])
    if not categories and not packages:
        page_text = html_text(raw_html).lower()
        recognized = (
            "aminet - " in page_text
            or "found 0 matching packages" in page_text
            or 'id="start_listing"' in page_text
        )
        if not recognized:
            raise AminetMarkupError(
                "Aminet returned a page format this version could not read."
            )
    return categories, packages


def child_categories(categories, parent_path):
    """Keep only immediate children of a browse path."""
    parent_parts = [part for part in parent_path.strip("/").split("/") if part]
    result = []
    for category in categories:
        parts = category["path"].split("/")
        if parts[:len(parent_parts)] == parent_parts and len(parts) == len(parent_parts) + 1:
            result.append(category)
    return result


def catalog_categories(path):
    """Return local category entries immediately below a catalog path."""
    if path not in AMINET_CATEGORY_PATHS:
        return []
    entries = []
    for child in AMINET_CATEGORY_TREE.get(path, ()):
        child_path = child if not path else path + "/" + child
        entries.append({
            "kind": "category",
            "title": child_path,
            "path": child_path,
            "description": "",
            "link": "",
        })
    return entries


def fetch_browse_packages(path):
    """Fetch one live package listing without consulting Aminet's tree."""
    architectures = normalize_architecture_filter(ARCHITECTURE_FILTER)
    if architectures is None:
        url = CATEGORY_URL_TEMPLATE % urllib.parse.quote(path, safe="/")
    else:
        url = build_advanced_search_url(path=path, architectures=architectures)
    raw = http_get(url)
    _, packages = parse_aminet_html(raw)
    packages = merge_packages([packages])
    if DEBUG_NETWORK:
        bbs.writeln("|08Browse package URL: %s" % url)
        bbs.writeln("|08Parsed packages: %d" % len(packages))
    return packages


def fetch_browse(path=""):
    """Fetch local categories or live packages for one Browse path."""
    path = normalize_browse_path(path)
    if path is None:
        raise AminetDoorError("Aminet returned an unsafe browse path.")
    categories = catalog_categories(path)
    packages = [] if categories else fetch_browse_packages(path)
    if DEBUG_NETWORK and categories:
        bbs.writeln("|08Browse catalog path: %s" % (path or "root"))
        bbs.writeln("|08Parsed categories: %d" % len(categories))
    return categories, packages


def build_search_url(query, page=1):
    """Build Aminet's public GET search URL with bounded user input."""
    query = terminal_text(query).strip()[:MAX_SEARCH_QUERY]
    values = {"query": query}
    if page > 1:
        values["page"] = page
    return SEARCH_URL + "?" + urllib.parse.urlencode(values)


def fetch_search(query):
    """Fetch the first page of Aminet's public search results."""
    architectures = normalize_architecture_filter(ARCHITECTURE_FILTER)
    if architectures is None:
        url = build_search_url(query)
    else:
        url = build_advanced_search_url(query=query, architectures=architectures)
    raw = http_get(url)
    _, packages = parse_aminet_html(raw)
    packages = merge_packages([packages], SEARCH_RESULT_LIMIT)
    if DEBUG_NETWORK:
        bbs.writeln("|08Search URL: %s" % url)
        bbs.writeln("|08Search result count: %d" % len(packages))
    return packages


def fetch_readme(path):
    """Return a package README from a fresh cache or Aminet."""
    stale_text = None
    if CACHE_ENABLED:
        cached = read_readme_cache(path)
        if cached is not None:
            cached_text, fresh = cached
            if fresh:
                debug_cache("README cache hit")
                return cached_text
            stale_text = cached_text
            debug_cache("README cache stale")
        else:
            debug_cache("README cache miss")

    url = README_URL_TEMPLATE % path
    try:
        raw = http_get(url)
    except AminetDoorError as exc:
        if stale_text is not None and isinstance(
                exc, (AminetTransientError, AminetTransportError)):
            debug_cache("README stale fallback used")
            return stale_text
        raise
    if len(raw) > MAX_README_BYTES:
        raw = raw[:MAX_README_BYTES]
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        text = raw.decode("latin-1", "replace")
    text = clean_extract(text)
    if not text:
        raise AminetDoorError("No readable text was returned.")
    if CACHE_ENABLED:
        if write_readme_cache(path, text):
            debug_cache("README cache refreshed")
        else:
            debug_cache("README cache write skipped")
    return text


def cache_directory():
    """Resolve an absolute cache path or one relative to Mystic's cwd."""
    if not isinstance(CACHE_DIR, str) or not CACHE_DIR:
        raise ValueError("CACHE_DIR must be a non-empty path")
    return os.path.abspath(CACHE_DIR)


def readme_cache_path(package_path):
    """Return a safe hashed JSON cache path for a canonical package path."""
    key = hashlib.sha256(package_path.encode("utf-8")).hexdigest()
    return os.path.join(cache_directory(), key + ".json")


def read_readme_cache(package_path):
    """Read and validate one cache entry, returning (text, fresh) or None."""
    try:
        cache_path = readme_cache_path(package_path)
        max_file_bytes = MAX_README_BYTES * 6 + 4096
        if os.path.getsize(cache_path) > max_file_bytes:
            return None
        with open(cache_path, "r", encoding="utf-8") as stream:
            payload = stream.read(max_file_bytes + 1)
        if len(payload.encode("utf-8")) > max_file_bytes:
            return None
        entry = json.loads(payload)
        if not isinstance(entry, dict):
            return None
        if entry.get("package_path") != package_path:
            return None
        fetched_at = entry.get("fetched_at")
        text = entry.get("text")
        if (isinstance(fetched_at, bool)
                or not isinstance(fetched_at, (int, float))
                or not isinstance(text, str)
                or len(text.encode("utf-8")) > MAX_README_BYTES):
            return None
        text = clean_extract(text)
        if not text:
            return None
        fresh = time.time() - fetched_at <= CACHE_MAX_AGE_SECONDS
        return text, fresh
    except (OSError, TypeError, ValueError, UnicodeError) as exc:
        debug_cache("README cache unavailable: %r" % (exc,))
        return None


def write_readme_cache(package_path, text):
    """Atomically write one validated README cache entry when possible."""
    temporary_path = None
    try:
        if len(text.encode("utf-8")) > MAX_README_BYTES:
            return False
        directory = cache_directory()
        cache_path = readme_cache_path(package_path)
        os.makedirs(directory, exist_ok=True)
        payload = json.dumps({
            "package_path": package_path,
            "fetched_at": time.time(),
            "text": text,
        }, ensure_ascii=True, separators=(",", ":"))
        descriptor, temporary_path = tempfile.mkstemp(
            prefix=".readme-", suffix=".tmp", dir=directory
        )
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary_path, cache_path)
        temporary_path = None
        return True
    except (OSError, TypeError, ValueError, UnicodeError) as exc:
        debug_cache("README cache unavailable: %r" % (exc,))
        return False
    finally:
        if temporary_path is not None:
            try:
                os.unlink(temporary_path)
            except OSError:
                pass


def debug_cache(message):
    """Log cache state only in developer diagnostics mode."""
    if DEBUG_NETWORK:
        bbs.writeln("|08%s" % message)


def current_user_identity():
    """Return a stable identity from Mystic's documented getuser(0) record."""
    try:
        user = bbs.getuser(0)
    except Exception as exc:
        debug_user_identity("getuser(0) failed: %r" % (exc,))
        return None
    if not isinstance(user, dict):
        debug_user_identity("getuser(0) returned %s" % type(user).__name__)
        return None
    for field in ("number", "id", "userid", "user_id", "name", "username", "handle"):
        value = user.get(field)
        if value is None or isinstance(value, bool):
            continue
        value = str(value).strip()
        if value and value.casefold() not in ("guest", "anonymous") and value != "0":
            return value
    debug_user_identity("getuser(0) keys: %s" % ", ".join(sorted(str(key) for key in user)))
    debug_user_identity("getuser(0) had no safe identity field")
    return None


def debug_user_identity(message):
    """Log only safe identity diagnostics in developer mode."""
    if DEBUG_NETWORK:
        bbs.writeln("|08Mystic user diagnostic: %s" % message)


def favorites_directory():
    """Resolve the configurable per-user favorites directory."""
    if not isinstance(USER_DATA_DIR, str) or not USER_DATA_DIR:
        raise ValueError("USER_DATA_DIR must be a non-empty path")
    return os.path.join(os.path.abspath(USER_DATA_DIR), "favorites")


def favorites_path(user_id):
    """Return a hash-based filename that cannot contain user path syntax."""
    key = hashlib.sha256(user_id.encode("utf-8")).hexdigest()
    return os.path.join(favorites_directory(), key + ".json")


def _load_favorites_state(user_id):
    """Return (favorites, available) without exposing storage exceptions."""
    if not isinstance(user_id, str) or not user_id:
        return [], False
    try:
        path = favorites_path(user_id)
        if not os.path.exists(path):
            return [], True
        if os.path.getsize(path) > MAX_FAVORITES_BYTES:
            raise ValueError("favorites file is too large")
        with open(path, "r", encoding="utf-8") as stream:
            payload = json.load(stream)
        if not isinstance(payload, dict) or not isinstance(payload.get("favorites"), list):
            raise ValueError("invalid favorites structure")
        favorites = []
        for item in payload["favorites"]:
            if not isinstance(item, dict) or not isinstance(item.get("path"), str):
                continue
            path_value = item["path"].strip()
            if not path_value:
                continue
            favorite = {
                "path": path_value,
                "title": str(item.get("title", path_value)),
                "description": str(item.get("description", "")),
            }
            if isinstance(item.get("added_at"), (int, float)):
                favorite["added_at"] = item["added_at"]
            favorites.append(favorite)
        return favorites, True
    except (OSError, TypeError, ValueError, UnicodeError) as exc:
        debug_cache("Favorites unavailable: %r" % (exc,))
        return [], False


def load_favorites(user_id=None):
    """Load the current user's favorites, safely returning an empty list."""
    user_id = user_id or current_user_identity()
    if user_id is None:
        return []
    favorites, _ = _load_favorites_state(user_id)
    return favorites


def save_favorites(user_id, favorites):
    """Atomically save one user's favorites, returning success status."""
    temporary_path = None
    try:
        directory = favorites_directory()
        path = favorites_path(user_id)
        os.makedirs(directory, exist_ok=True)
        payload = json.dumps({"favorites": favorites}, ensure_ascii=True,
                             separators=(",", ":"))
        if len(payload.encode("utf-8")) > MAX_FAVORITES_BYTES:
            raise ValueError("favorites file is too large")
        descriptor, temporary_path = tempfile.mkstemp(
            prefix=".favorites-", suffix=".tmp", dir=directory
        )
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary_path, path)
        temporary_path = None
        return True
    except (OSError, TypeError, ValueError, UnicodeError) as exc:
        debug_cache("Favorites unavailable: %r" % (exc,))
        return False
    finally:
        if temporary_path is not None:
            try:
                os.unlink(temporary_path)
            except OSError:
                pass


def toggle_favorite(user_id, package):
    """Toggle a package by canonical path; return added/removed or None."""
    favorites, available = _load_favorites_state(user_id)
    if not available:
        return None
    package_path = package.get("path") if isinstance(package, dict) else None
    if not isinstance(package_path, str) or not package_path.strip():
        return None
    package_path = package_path.strip()
    existing = next((item for item in favorites if item["path"] == package_path), None)
    if existing is not None:
        updated = [item for item in favorites if item["path"] != package_path]
        return False if save_favorites(user_id, updated) else None
    record = {
        "path": package_path,
        "title": str(package.get("title", package_path)),
        "description": str(package.get("description", "")),
        "added_at": time.time(),
    }
    return True if save_favorites(user_id, favorites + [record]) else None


def remove_favorite(user_id, package_path):
    """Remove one favorite by canonical path; return success status."""
    favorites, available = _load_favorites_state(user_id)
    if not available:
        return None
    updated = [item for item in favorites if item["path"] != package_path]
    if len(updated) == len(favorites):
        return False
    return True if save_favorites(user_id, updated) else None


def favorite_status(package):
    """Return whether the current user has a package bookmarked."""
    user_id = current_user_identity()
    if user_id is None:
        return False
    return any(item.get("path") == package.get("path") for item in load_favorites(user_id))


def show_favorite_feedback(result):
    """Show compact non-blocking favorite feedback."""
    if result is True:
        bbs.writeln("|10Added to favorites.")
    elif result is False:
        bbs.writeln("|10Removed from favorites.")
    else:
        bbs.writeln("|12Favorites are unavailable.")


def line(char="-"):
    return char * 78


def clear_screen():
    bbs.write("|CL")


def heading(title):
    clear_screen()
    bbs.writeln("|15" + line("="))
    bbs.writeln("|11 AminetDoor |07v%s  |08-  Aminet from your BBS" % VERSION)
    bbs.writeln("|15" + line("="))
    if title:
        safe = terminal_text(title)
        if len(safe) > 72:
            safe = safe[:69] + "..."
        bbs.writeln("|14 " + safe)
        bbs.writeln("|08" + line("-"))


def pause(message="Press any key"):
    bbs.write("|08%s..." % message)
    bbs.onekey(chr(13) + ESC + "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 ", False)


def search_query_input():
    """Read one Search query, allowing Escape to cancel immediately."""
    value = read_text_input(MAX_SEARCH_QUERY)
    return None if value is None else terminal_text(value).strip()


def key_value(key):
    """Return the character portion of a Mystic key result."""
    if isinstance(key, tuple) and key:
        return key[0]
    return key


def read_text_input(max_length, *, allow_cancel=True):
    """Read bounded ASCII text through Mystic getkey()."""
    chars = []
    limit = max(0, max_length)
    while True:
        value = key_value(bbs.getkey())
        if allow_cancel and value in (ESC, 27):
            return None
        if value in ("\r", "\n", 13):
            return "".join(chars)
        if value in ("\b", "\x7f", 8, 127):
            if chars:
                chars.pop()
                bbs.write("\b \b")
            continue
        if isinstance(value, int) and 32 <= value <= 126:
            value = chr(value)
        if (isinstance(value, str) and len(value) == 1
                and 32 <= ord(value) <= 126):
            if len(chars) < limit:
                chars.append(value)
                bbs.write(value)


def diagnose_key(value):
    """Optionally show the raw value returned by Mystic while debugging keys."""
    if not DEBUG_KEYS:
        return
    values = value if isinstance(value, tuple) else (value,)
    bbs.writeln("|08key=%r type=%s length=%s ordinals=%r" % (
        value,
        type(value).__name__,
        len(value) if hasattr(value, "__len__") else "n/a",
        [ord(ch) for ch in values[0] if isinstance(values[0], str)]
        if values and isinstance(values[0], str) else [],
    ))


def normalize_key(key):
    """Translate Mystic input into shared navigation actions."""
    diagnose_key(key)
    value = key[0] if isinstance(key, tuple) and key else key
    extended = (
        isinstance(key, tuple) and len(key) > 1 and key[1] is True
    )
    if value in (ESC, 27):
        return "quit"
    if extended and value == "H":
        return "up"
    if extended and value == "P":
        return "down"
    if value in ("\r", "\n", 13):
        return "enter"
    if isinstance(value, str) and value.upper() == "Q":
        return "quit"
    if isinstance(value, str) and value.upper() == "B":
        return "back"
    if isinstance(value, str) and value.upper() == "R":
        return "root"
    if isinstance(value, str) and value.upper() == "S":
        return "search"
    if isinstance(value, str) and value.upper() == "J":
        return "jump"
    if isinstance(value, str) and value.upper() == "F":
        return "favorite"
    if isinstance(value, str) and value.upper() == "D":
        return "delete"
    if isinstance(value, str) and value.upper() == "N":
        return "next"
    if isinstance(value, str) and value.upper() == "P":
        return "previous"
    return "unknown"


def normalize_menu_key(key):
    """Translate main-menu keys without changing Browse's R meaning."""
    action = normalize_key(key)
    if key_value(key) in ("P", "p"):
        return "package_day"
    if key_value(key) in ("F", "f"):
        return "favorites"
    if action == "root":
        return "recent"
    if action == "unknown" and key_value(key) in ("A", "a"):
        return "about"
    return action


def selector_mode():
    """Return a safe selector mode, falling back for a SysOp typo."""
    if RESULT_SELECTOR in ("lightbar", "numbered"):
        return RESULT_SELECTOR
    return "numbered"


def move_selector(selected_index, viewport_start, action, item_count,
                  visible_rows=VISIBLE_RESULT_ROWS):
    """Apply a selector action and return (selection, viewport) state."""
    if not item_count:
        return 0, 0, action
    last_index = item_count - 1
    if action == "up":
        selected_index = max(0, selected_index - 1)
    elif action == "down":
        selected_index = min(last_index, selected_index + 1)
    elif action in ("enter", "quit"):
        return selected_index, viewport_start, action

    if selected_index < viewport_start:
        viewport_start = selected_index
    elif selected_index >= viewport_start + visible_rows:
        viewport_start = selected_index - visible_rows + 1
    max_start = max(0, item_count - visible_rows)
    viewport_start = min(viewport_start, max_start)
    return selected_index, viewport_start, action


def show_error(message):
    bbs.writeln("")
    bbs.writeln("|12Error: |07" + terminal_text(message))
    bbs.writeln("")
    pause()


def read_readme(package_title, path):
    try:
        text = fetch_readme(path)
    except AminetDoorError as exc:
        show_error(str(exc))
        return

    lines = wrap_text(text)
    if not lines:
        show_error("No readable README text was returned.")
        return

    page_count = max(1, (len(lines) + PAGE_LINES - 1) // PAGE_LINES)
    page = 0

    while True:
        heading(package_title)
        start = page * PAGE_LINES
        end = min(start + PAGE_LINES, len(lines))
        for text_line in lines[start:end]:
            bbs.writeln("|07" + text_line)
        for _ in range(PAGE_LINES - (end - start)):
            bbs.writeln("")

        bbs.writeln("|08" + line("-"))
        bbs.writeln(
            "|11Page %d/%d  |15[N]|07ext  |15[P]|07rev  |15[F]|07av  |15[ESC/Q]|07 Back"
            % (page + 1, page_count)
        )
        action = normalize_key(bbs.onekey("NPFQ" + ESC, False))
        if action == "next" and page < page_count - 1:
            page += 1
        elif action == "previous" and page > 0:
            page -= 1
        elif action == "favorite":
            user_id = current_user_identity()
            if user_id is None:
                show_favorite_feedback(None)
            else:
                show_favorite_feedback(toggle_favorite(
                    user_id, {"title": package_title, "path": path}
                ))
        elif action == "quit":
            return


def package_display(item):
    """Format compact package metadata for an 80-column result row."""
    title = terminal_text(item.get("title", ""))
    version = terminal_text(item.get("version", ""))
    size = terminal_text(item.get("size", ""))
    description = terminal_text(item.get("description", ""))
    suffix = "  ".join(part for part in (version, size) if part)
    if suffix:
        suffix = "  " + suffix
    text = title + suffix
    if description:
        text += "  " + description
    return text


def category_display(item):
    title = terminal_text(item.get("title", ""))
    description = terminal_text(item.get("description", ""))
    return title + ("  " + description if description else "")


def render_lightbar(items, selected_index, viewport_start, title="Recent uploads",
                    formatter=None, controls="Up/Down Move   Enter Read   F Fav   ESC/Q Back"):
    heading(title)
    formatter = formatter or (lambda item: item.get("title", ""))
    visible_end = min(viewport_start + VISIBLE_RESULT_ROWS, len(items))
    for index in range(viewport_start, visible_end):
        marker = ">  " if index == selected_index else "   "
        row_text = terminal_text(formatter(items[index]))
        width = 76 - len(marker)
        if len(row_text) > width:
            row_text = row_text[:max(0, width - 3)] + "..."
        bbs.writeln("|15%s|07%s" % (marker, row_text))
    for _ in range(VISIBLE_RESULT_ROWS - (visible_end - viewport_start)):
        bbs.writeln("")
    bbs.writeln("|08" + line("-"))
    bbs.writeln("|11%s" % controls)


def choose_result_lightbar(items, title="Recent uploads", formatter=None,
                           controls="Up/Down Move   Enter Read   F Fav   ESC/Q Back",
                           extra_actions=()):
    """Select an item using Mystic's native extended-key input."""
    selected_index = 0
    viewport_start = 0
    while True:
        render_lightbar(items, selected_index, viewport_start, title, formatter, controls)
        action = normalize_key(bbs.getkey())
        selected_index, viewport_start, action = move_selector(
            selected_index, viewport_start, action, len(items)
        )
        if action == "enter":
            return items[selected_index]
        if action == "quit":
            return None
        if action == "delete" and action in extra_actions:
            return ("delete", items[selected_index])
        if action == "favorite" and action in extra_actions:
            item = items[selected_index]
            if item.get("kind") != "category":
                user_id = current_user_identity()
                show_favorite_feedback(
                    None if user_id is None else toggle_favorite(user_id, item)
                )
            continue
        if action in extra_actions:
            return action


def render_numbered(items, page):
    heading("Recent uploads")
    page_count = max(1, (len(items) + VISIBLE_RESULT_ROWS - 1) // VISIBLE_RESULT_ROWS)
    start = page * VISIBLE_RESULT_ROWS
    end = min(start + VISIBLE_RESULT_ROWS, len(items))
    for index in range(start, end):
        title = terminal_text(items[index].get("title", ""))
        if len(title) > 69:
            title = title[:66] + "..."
        bbs.writeln("|15 %2d.|07 %s" % (index + 1, title))
    for _ in range(VISIBLE_RESULT_ROWS - (end - start)):
        bbs.writeln("")
    bbs.writeln("|08" + line("-"))
    bbs.write("|11Choose package |08[1-%d] |11Page %d/%d, or |15ESC/Q|11: " % (
        len(items), page + 1, page_count
    ))


def choose_result_numbered(items):
    """Select an item with multi-digit Mystic string input."""
    page = 0
    page_count = max(1, (len(items) + VISIBLE_RESULT_ROWS - 1) // VISIBLE_RESULT_ROWS)
    while True:
        render_numbered(items, page)
        value = read_text_input(2)
        if value is None:
            return None
        value = terminal_text(value).strip()
        action = normalize_key(value)
        if action == "quit":
            return None
        if action == "next" and page < page_count - 1:
            page += 1
            continue
        if action == "previous" and page > 0:
            page -= 1
            continue
        try:
            index = int(value) - 1
            if index < 0:
                raise IndexError
            selected = items[index]
        except (ValueError, IndexError, TypeError):
            continue
        return selected


def choose_recent_result(items):
    """Dispatch parsed recent items to the configured result selector."""
    if selector_mode() == "lightbar":
        return choose_result_lightbar(
            items,
            controls="Up/Down Move   Enter Read   F Fav   ESC/Q Back",
            extra_actions=("favorite",),
        )
    return choose_result_numbered(items)


def show_recent():
    try:
        items = fetch_recent()
    except AminetDoorError as exc:
        show_error(str(exc))
        return
    if not items:
        show_error("No recent uploads were returned.")
        return
    selected = choose_recent_result(items)
    if selected is not None:
        read_readme(selected["title"], selected["path"])


def render_package_of_day(item):
    """Render the compact Package of the Day spotlight screen."""
    heading("Package of the Day")
    bbs.writeln("|08Spotlight for %s" % date.today().isoformat())
    bbs.writeln("")
    title = terminal_text(item.get("title") or item.get("path", ""))
    bbs.writeln("|11" + title[:72])
    bbs.writeln("")
    bbs.writeln("|07Path: " + terminal_text(item.get("path", "")))
    description = terminal_text(item.get("description", ""))
    if description:
        bbs.writeln("|07Description:")
        for text_line in wrap_text(description, width=72)[:4]:
            bbs.writeln("|07" + text_line)
    bbs.writeln("")
    bbs.writeln("|08" + line("-"))
    bbs.writeln("|15[ENTER]|07 Read   |15[F]|07 Favorite   |15[R]|07 Another   |15[ESC/Q]|07 Back")


def show_package_of_day():
    """Show a deterministic daily Recent package and optional alternatives."""
    try:
        items = fetch_recent()
    except AminetDoorError as exc:
        show_error(str(exc))
        return
    if not items:
        show_error("No packages are available for today's spotlight.")
        return

    candidates = [item for item in items if isinstance(item, dict) and item.get("path")]
    selected = package_of_day(candidates)
    if selected is None:
        show_error("No packages are available for today's spotlight.")
        return
    selected_index = candidates.index(selected)
    while True:
        render_package_of_day(selected)
        action = normalize_key(bbs.onekey("RF" + chr(13) + ESC, False))
        if action == "enter":
            read_readme(selected.get("title", selected["path"]), selected["path"])
        elif action == "favorite":
            user_id = current_user_identity()
            show_favorite_feedback(
                None if user_id is None else toggle_favorite(user_id, selected)
            )
        elif action == "root":
            if len(candidates) > 1:
                selected_index = (selected_index + 1) % len(candidates)
                selected = candidates[selected_index]
        elif action == "quit":
            return


def choose_browse_entry(items, path):
    """Select a browse category/package while honoring browse controls."""
    title = "Browse" if not path else "Browse: " + path
    formatter = category_display if items and items[0].get("kind") == "category" else package_display
    return choose_result_lightbar(
        items,
        title=title,
        formatter=formatter,
        controls="Up/Down Move  Enter Open  B Back  R Root  J Jump  F Fav  ESC/Q Exit",
        extra_actions=("back", "root", "jump", "favorite"),
    )


def normalize_browse_path(value):
    """Normalize a safe category path, returning None for invalid input."""
    if not isinstance(value, str):
        return None
    value = value.strip().rstrip("/")
    if not value:
        return ""
    return value if BROWSE_PATH_RE.fullmatch(value) else None


def read_quick_path():
    """Prompt for a validated Browse category path, or return None."""
    heading("Browse")
    bbs.writeln("|07Jump to Aminet path:")
    bbs.write("|15> ")
    value = read_text_input(MAX_QUICK_PATH)
    if value is None or not value.strip():
        return None
    path = normalize_browse_path(value)
    if path is None:
        show_error("Invalid Aminet path.")
        return None
    return path


def browse_path_after_action(path, action, selected=None):
    """Return the next browse path, or None when Browse should exit."""
    if action == "root":
        return ""
    if action == "back":
        if "/" in path:
            return path.rsplit("/", 1)[0]
        return "" if path else None
    if isinstance(selected, dict) and selected.get("kind") == "category":
        return selected.get("path", path)
    return path


def browse():
    """Browse Aminet's category tree and package listings."""
    path = ""
    pending_entries = None
    while True:
        if pending_entries is None:
            try:
                categories, packages = fetch_browse(path)
            except AminetDoorError as exc:
                show_error(str(exc))
                return
        else:
            categories, packages = pending_entries
            pending_entries = None
        entries = categories or packages
        if not entries:
            show_error("No browse entries were returned.")
            return
        selected = choose_browse_entry(entries, path)
        if selected in ("back", "root"):
            path = browse_path_after_action(path, selected)
            if path is None:
                return
        elif selected == "jump":
            target_path = read_quick_path()
            if target_path is None:
                continue
            try:
                target_categories, target_packages = fetch_browse(target_path)
            except AminetDoorError as exc:
                show_error(str(exc))
                continue
            if not target_categories and not target_packages:
                show_error("No Aminet category found for that path.")
                continue
            path = target_path
            pending_entries = (target_categories, target_packages)
        elif selected is None:
            return
        elif selected.get("kind") == "category":
            path = browse_path_after_action(path, "enter", selected)
        else:
            read_readme(selected["title"], selected["path"])


def search():
    """Prompt for bounded queries and display Aminet search results."""
    while True:
        heading("Search Aminet")
        bbs.writeln("|07Enter a package name or keyword (max %d characters)." % MAX_SEARCH_QUERY)
        bbs.writeln("|08ESCAPE returns to the main menu; Q also works.")
        bbs.write("|11Search: |15")
        query = search_query_input()
        if query is None:
            return
        if not query:
            continue
        if query.upper() == "Q":
            return
        try:
            items = fetch_search(query)
        except AminetDoorError as exc:
            show_error(str(exc))
            return
        if not items:
            show_error("No packages matched that search.")
            continue
        selected = choose_result_lightbar(
            items,
            title="Search: " + query,
            formatter=package_display,
            controls="Up/Down Move   Enter Read   S Search   F Fav   ESC/Q Back",
            extra_actions=("search", "favorite"),
        )
        if selected == "search":
            continue
        if selected is not None:
            read_readme(selected["title"], selected["path"])


def favorite_display(item):
    """Format a favorite for the 80-column lightbar."""
    title = terminal_text(item.get("title", item.get("path", "")))
    path = terminal_text(item.get("path", ""))
    return title + ("  " + path if path else "")


def show_empty_favorites():
    """Display the non-error empty Favorites state."""
    heading("Favorites")
    bbs.writeln("|07No favorite Aminet packages yet.")
    bbs.writeln("")
    bbs.writeln("|07Press F while viewing a package to bookmark it.")
    bbs.writeln("")
    bbs.writeln("|08ESC/Q Back")
    bbs.onekey("FQ" + ESC, False)


def show_favorites():
    """Display and manage the current Mystic user's local favorites."""
    user_id = current_user_identity()
    if user_id is None:
        show_error("Favorites are unavailable.")
        return
    favorites, available = _load_favorites_state(user_id)
    if not available:
        show_error("Favorites are unavailable.")
        return
    if not favorites:
        show_empty_favorites()
        return

    while True:
        selected = choose_result_lightbar(
            favorites,
            title="Favorites",
            formatter=favorite_display,
            controls="Up/Down Move   Enter Read   D Delete   ESC/Q Back",
            extra_actions=("delete",),
        )
        if selected is None:
            return
        if isinstance(selected, tuple) and selected[0] == "delete":
            result = remove_favorite(user_id, selected[1].get("path", ""))
            if result is None:
                show_error("Favorites are unavailable.")
                return
            if result:
                show_favorite_feedback(False)
            favorites, available = _load_favorites_state(user_id)
            if not available:
                show_error("Favorites are unavailable.")
                return
            if not favorites:
                show_empty_favorites()
                return
            continue
        read_readme(selected.get("title", selected["path"]), selected["path"])


def about():
    heading("About")
    bbs.writeln("|07AminetDoor is an open-source Aminet browser for Mystic BBS.")
    bbs.writeln("")
    bbs.writeln("|07(c) 2026 Per Gustav Ousdal")
    bbs.writeln("|07Phrenetic BBS")
    bbs.writeln("|07telnet: bbs.phrenetic.no")
    bbs.writeln("")
    bbs.writeln("|07Released under the MIT License.")
    bbs.writeln("")
    bbs.writeln("|08" + line("-"))
    bbs.writeln("|07Powered by Aminet.")
    bbs.writeln("")
    bbs.writeln("|07Package descriptions and README text remain subject to the")
    bbs.writeln("|07licensing/copyright terms of their original authors.")
    bbs.writeln("")
    pause()


def main():
    while True:
        heading("Main menu")
        bbs.writeln("")
        bbs.writeln("|15 [R]|07 Recent uploads")
        bbs.writeln("|15 [B]|07 Browse Aminet")
        bbs.writeln("|15 [S]|07 Search Aminet")
        bbs.writeln("|15 [P]|07 Package of the Day")
        bbs.writeln("|15 [F]|07 Favorites")
        bbs.writeln("|15 [A]|07 About")
        bbs.writeln("|15 [Q]|07 Return to BBS")
        bbs.writeln("")
        bbs.writeln("|08ESCAPE returns to BBS")
        bbs.write("|11Select: |15")
        action = normalize_menu_key(bbs.onekey("RBSPFAQ" + ESC, True))

        if action == "quit":
            clear_screen()
            return
        if action == "about":
            about()
        elif action == "recent":
            show_recent()
        elif action == "back":
            browse()
        elif action == "search":
            search()
        elif action == "package_day":
            show_package_of_day()
        elif action == "favorites":
            show_favorites()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        clear_screen()
    except Exception as exc:
        try:
            bbs.writeln("")
            bbs.writeln("|12AminetDoor stopped: |07" + terminal_text(str(exc)))
            bbs.writeln("|08Please report this to the SysOp.")
            bbs.writeln("")
            pause()
        except Exception:
            pass
